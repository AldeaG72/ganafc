# Cheia API din https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Expeditorul emailurilor. Până la verificarea domeniului în Resend folosiți
# onboarding@resend.dev (atunci Resend livrează DOAR către adresa contului Resend).
# După verificare: "GANA F&C <oferte@domeniul-vostru.ro>"
EMAIL_FROM="GANA F&C <onboarding@resend.dev>"

# Adresa (sau adresele, separate prin virgulă) unde firma primește solicitările
EMAIL_TO=contact@exemplu.ro
